// AltiVec / VMX (primary opcode 4) instruction list.
//
// VOP(Enum, name, kind, form, xo)
//   name  - mnemonic; also the name of the runtime helper ppu::vmx::<name>
//   kind  - helper signature:
//             DAB  (d, a, b)        DB   (d, b)            DABC (d, a, b, c)
//             DABS (d, a, b, shb)   DBU  (d, b, uimm5)     DS   (d, simm5)
//             CMP  (d, a, b) and, with the record bit, CR6 is updated
//             MFVSCR / MTVSCR  handled inline by the lifter
//   form  - VA: xo = i & 63   VX: xo = i & 0x7FF   VC: xo = i & 0x3FF (record bit = 0x400)
//
// Note: in VA form the C operand is bits 21..25 (i >> 6). For vmaddfp/vnmsubfp the
// architected operation is vD = vA * vC + vB; the helpers receive (d, a, b, c) and
// implement exactly that.

// ---- VA form ----
VOP(Vmhaddshs,  vmhaddshs,  DABC, VA, 32)
VOP(Vmhraddshs, vmhraddshs, DABC, VA, 33)
VOP(Vmladduhm,  vmladduhm,  DABC, VA, 34)
VOP(Vmsumubm,   vmsumubm,   DABC, VA, 36)
VOP(Vmsummbm,   vmsummbm,   DABC, VA, 37)
VOP(Vmsumuhm,   vmsumuhm,   DABC, VA, 38)
VOP(Vmsumuhs,   vmsumuhs,   DABC, VA, 39)
VOP(Vmsumshm,   vmsumshm,   DABC, VA, 40)
VOP(Vmsumshs,   vmsumshs,   DABC, VA, 41)
VOP(Vsel,       vsel,       DABC, VA, 42)
VOP(Vperm,      vperm,      DABC, VA, 43)
VOP(Vsldoi,     vsldoi,     DABS, VA, 44)
VOP(Vmaddfp,    vmaddfp,    DABC, VA, 46)
VOP(Vnmsubfp,   vnmsubfp,   DABC, VA, 47)

